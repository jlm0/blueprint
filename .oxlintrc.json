{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "rules": {
    "eslint/no-control-regex": "off",
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": [
        "**/src/core/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/prototype/**",
                  "**/mcp/**",
                  "**/app/**",
                  "**/hooks/**",
                  "**/scripts/**",
                  "**/design/**"
                ],
                "message": "core is the bottom layer, so it imports only core. Fix: move the shared code into core, or pass it in as a parameter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/core/migrations/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/prototype/**",
                  "**/mcp/**",
                  "**/app/**",
                  "**/hooks/**",
                  "**/scripts/**",
                  "**/design/**"
                ],
                "message": "core is the bottom layer, so it imports only core. Fix: move the shared code into core, or pass it in as a parameter."
              },
              {
                "group": [
                  "**/schemas/**",
                  "zod",
                  "zod/*"
                ],
                "message": "A migration step is frozen, so it does not read a live schema. Fix: copy the values into the step."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/core/markup.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*",
                  "../*"
                ],
                "message": "markup is a leaf module, so it imports nothing else from Blueprint. Fix: move the code that needs it out of markup."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/core/css.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*",
                  "../*"
                ],
                "message": "css is a leaf module, so it imports nothing else from Blueprint. Fix: move the code that needs it out of css."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/prototype/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/mcp/**",
                  "**/app/**",
                  "**/hooks/**",
                  "**/scripts/**"
                ],
                "message": "prototype sits under the MCP server and the canvas. Fix: move the shared code into prototype or core."
              },
              {
                "group": [
                  "**/core/schemas/**",
                  "zod",
                  "zod/*"
                ],
                "message": "The site bundle does not load zod. Fix: import the type from core/types with import type, or move the code to the MCP server."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/mcp/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/**",
                  "**/scripts/**"
                ],
                "message": "The MCP server does not import the canvas or scripts. Fix: move the shared code into core."
              },
              {
                "group": [
                  "**/validate-project",
                  "**/core/validate",
                  "**/project-validation-worker"
                ],
                "message": "Validation stalls the MCP event loop on the main thread. Fix: run it through src/mcp/project-validation.ts, which starts src/mcp/project-validation-worker.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/mcp/project-validation-worker.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/app/**",
                  "**/scripts/**"
                ],
                "message": "The MCP server does not import the canvas or scripts. Fix: move the shared code into core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/app/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/mcp/**",
                  "**/hooks/**",
                  "**/scripts/**"
                ],
                "message": "The canvas does not import the MCP server. Fix: move the shared code into core."
              },
              {
                "group": [
                  "**/core/schemas/**",
                  "zod",
                  "zod/*"
                ],
                "message": "The site bundle does not load zod. Fix: import the type from core/types with import type."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/mcp/operations.ts"
      ],
      "rules": {
        "eslint/max-lines": [
          "error",
          {
            "max": 800
          }
        ]
      }
    },
    {
      "files": [
        "**/src/app/**/*.ts"
      ],
      "rules": {
        "eslint/max-lines": [
          "error",
          {
            "max": 800
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    ".blueprint-artifacts/**",
    "node_modules/**"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  }
}
