{
  "name": "blueprint",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "blueprint-mcp": "./dist/mcp/server.js",
    "blueprint-codex-hook": "./dist/mcp/codex-activity-hook.js"
  },
  "exports": {
    ".": "./dist/mcp/index.js",
    "./schema/blueprint-project.schema.json": "./schema/blueprint-project.schema.json"
  },
  "files": [
    "dist/mcp",
    "dist/site",
    "schema",
    "starter",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "oxlint --ignore-pattern 'tests/lint-fixtures/**' .",
    "lint:fix": "oxlint --ignore-pattern 'tests/lint-fixtures/**' --fix .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --import tsx --test --test-timeout=300000 tests/*.test.ts",
    "test:browser": "node --import tsx --test tests/browser/*.test.ts",
    "check:fixtures": "node --import tsx src/scripts/validate-fixtures.ts",
    "scan:scope": "node --import tsx src/scripts/scope-scan.ts",
    "extract:artifacts": "node --import tsx src/scripts/create-extraction-artifacts.ts",
    "smoke:browser": "node --import tsx src/scripts/browser-smoke.ts",
    "build:site": "vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts && chmod +x dist/mcp/server.js dist/mcp/codex-activity-hook.js",
    "build": "npm run build:site && npm run build:mcp",
    "qa": "npm run lint && npm run typecheck && npm run check:fixtures && npm run test:unit && npm run extract:artifacts && npm run scan:scope && npm run build && npm run test:browser && npm run smoke:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "html-to-image": "^1.11.13",
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": "^1.49.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "oxlint": "^1.79.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
