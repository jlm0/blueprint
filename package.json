{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "blueprint-mcp": "./dist/mcp/server.js",
    "blueprint-codex-hook": "./dist/mcp/codex-activity-hook.js"
  },
  "exports": {
    ".": "./dist/mcp/index.js",
    "./schema/blueprint-project.schema.json": "./schema/blueprint-project.schema.json"
  },
  "files": [
    "dist/mcp",
    "dist/site",
    "docs",
    "schema",
    "starter",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:fixtures": "node --import tsx src/scripts/validate-fixtures.ts",
    "scan:scope": "node --import tsx src/scripts/scope-scan.ts",
    "extract:artifacts": "node --import tsx src/scripts/create-extraction-artifacts.ts",
    "smoke:browser": "node --import tsx src/scripts/browser-smoke.ts",
    "build:site": "vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts && chmod +x dist/mcp/server.js dist/mcp/codex-activity-hook.js",
    "build": "npm run build:site && npm run build:mcp",
    "qa": "npm run typecheck && npm run check:fixtures && npm test && npm run extract:artifacts && npm run scan:scope && npm run build && npm run smoke:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "html-to-image": "^1.11.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
