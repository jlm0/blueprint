{
  "schemaVersion": "1.0.0",
  "projectId": "starter-app",
  "screens": [
    {
      "id": "home",
      "name": "Agent Console",
      "description": "Mobile home screen for Loop, an AI agent harness app: live run status, run history, and a task composer.",
      "framePresetId": "phone",
      "styleRefs": ["screen.home"],
      "notes": ["Composed only from starter primitives and neutral tokens to prove app-agnostic prototyping."],
      "prototypeOnly": false,
      "implementationHints": ["Translate sections into the target app's screen/component structure."],
      "sections": [
        {
          "id": "top-nav",
          "name": "Top Navigation",
          "description": "App title bar with overflow actions.",
          "styleRefs": ["screen.home.top-nav"],
          "uses": [
            {
              "kind": "state-set",
              "id": "nav-bar/slots",
              "reason": "Screen header",
              "binding": { "slot": "header", "variant": "right-only", "copy": "Loop" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "active-run",
          "name": "Active Run",
          "description": "Hero card summarizing the run currently in progress.",
          "styleRefs": ["screen.home.active-run"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Run summary hero",
              "binding": {
                "slot": "hero",
                "variant": "default",
                "copy": "Active run | Refactor billing service | Opus 4.8 · 3 agents cooperating · 12 min elapsed",
                "data": "runs.active",
                "layout": "hero"
              }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "run-signals",
          "name": "Run Signals",
          "description": "Live status badges for the active run.",
          "styleRefs": ["screen.home.run-signals"],
          "uses": [
            {
              "kind": "state-set",
              "id": "badge/variant",
              "reason": "Health signal",
              "binding": { "slot": "signals", "variant": "success", "copy": "Tests passing", "data": "runs.active.checks", "layout": "row fit" }
            },
            {
              "kind": "state-set",
              "id": "badge/variant",
              "reason": "Concurrency signal",
              "binding": { "slot": "signals", "variant": "tonal", "copy": "3 agents", "data": "runs.active.agents", "layout": "row fit" }
            },
            {
              "kind": "state-set",
              "id": "badge/variant",
              "reason": "Context signal",
              "binding": { "slot": "signals", "variant": "outline", "copy": "branch: main", "data": "runs.active.branch", "layout": "row fit" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "run-stats",
          "name": "Run Stats",
          "description": "Key metrics for the active run.",
          "styleRefs": ["screen.home.run-stats"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Token spend metric",
              "binding": { "slot": "stats", "variant": "flat", "copy": "Tokens | 48.2K", "data": "runs.active.tokens", "layout": "grid-3 stat" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Cost metric",
              "binding": { "slot": "stats", "variant": "flat", "copy": "Cost | $1.94", "data": "runs.active.cost", "layout": "grid-3 stat" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Step count metric",
              "binding": { "slot": "stats", "variant": "flat", "copy": "Steps | 36", "data": "runs.active.steps", "layout": "grid-3 stat" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "recent-label",
          "name": "Recent Runs Label",
          "description": "Section eyebrow for run history.",
          "styleRefs": ["screen.home.recent-label"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Section heading text",
              "binding": { "slot": "heading", "variant": "flat", "copy": "Recent runs", "layout": "text eyebrow" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "recent-runs",
          "name": "Recent Runs",
          "description": "Grouped history of the latest agent runs.",
          "styleRefs": ["screen.home.recent-runs"],
          "uses": [
            {
              "kind": "state-set",
              "id": "pressable-row/shape",
              "reason": "Run history row",
              "binding": { "slot": "history", "variant": "group-first", "copy": "Fix flaky auth tests | Running", "data": "runs.recent.0" }
            },
            {
              "kind": "state-set",
              "id": "pressable-row/shape",
              "reason": "Run history row",
              "binding": { "slot": "history", "variant": "group-middle", "copy": "Write release notes | Queued", "data": "runs.recent.1" }
            },
            {
              "kind": "state-set",
              "id": "pressable-row/shape",
              "reason": "Run history row",
              "binding": { "slot": "history", "variant": "group-last", "copy": "Migrate CI to pnpm | Done", "data": "runs.recent.2" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "primary-action",
          "name": "Primary Action",
          "description": "Task composer: describe a task and hand it to the agents.",
          "styleRefs": ["screen.home.primary-action"],
          "uses": [
            {
              "kind": "state-set",
              "id": "input/variant",
              "reason": "Task description input",
              "binding": { "slot": "composer", "variant": "filled", "copy": "Describe a task for your agents…", "data": "composer.draft", "layout": "row grow" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Main command",
              "binding": { "slot": "composer", "variant": "primary", "copy": "Continue", "layout": "row fit", "accessibility": "Submit the described task to the agent queue." }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "session-controls",
          "name": "Session Controls",
          "description": "Autonomy preferences for the current session.",
          "styleRefs": ["screen.home.session-controls"],
          "uses": [
            {
              "kind": "state-set",
              "id": "switch/state",
              "reason": "Auto-approval preference",
              "binding": { "slot": "controls", "variant": "on", "copy": "Auto-approve safe commands", "data": "session.autoApprove" }
            },
            {
              "kind": "state-set",
              "id": "slider/tone",
              "reason": "Autonomy level control",
              "binding": { "slot": "controls", "variant": "primary", "copy": "Autonomy", "data": "session.autonomy" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        }
      ]
    },
    {
      "id": "web-home",
      "name": "Pulse Landing",
      "description": "Desktop marketing landing page for Pulse, a product analytics app — a different product on the same neutral system.",
      "framePresetId": "desktop-web-page",
      "productionRelationship": {
        "kind": "new-route",
        "routePath": "/"
      },
      "styleRefs": ["screen.web-home"],
      "notes": ["Proves the same tokens and primitives compose into a distinct app's web surface."],
      "prototypeOnly": false,
      "implementationHints": ["Translate sections into the target app's desktop route or page component structure."],
      "sections": [
        {
          "id": "site-nav",
          "name": "Site Navigation",
          "description": "Logo, product links, and the signup command.",
          "styleRefs": ["screen.web-home.site-nav"],
          "uses": [
            {
              "kind": "state-set",
              "id": "badge/variant",
              "reason": "Wordmark chip",
              "binding": { "slot": "brand", "variant": "outline", "copy": "Pulse", "layout": "row grow" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Product link",
              "binding": { "slot": "links", "variant": "ghost", "copy": "Product", "layout": "row fit" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Pricing link",
              "binding": { "slot": "links", "variant": "ghost", "copy": "Pricing", "layout": "row fit" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Docs link",
              "binding": { "slot": "links", "variant": "ghost", "copy": "Docs", "layout": "row fit" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Primary signup command",
              "binding": { "slot": "cta", "variant": "primary", "copy": "Get started", "layout": "row fit" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "hero-copy",
          "name": "Hero Copy",
          "description": "Headline statement for the landing page.",
          "styleRefs": ["screen.web-home.hero-copy"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Hero headline text",
              "binding": {
                "slot": "hero",
                "variant": "flat",
                "copy": "Product analytics, live | See every user journey as it happens | Pulse turns raw product events into live, explorable answers — no SQL, no waiting, no dashboards to babysit.",
                "layout": "hero center narrow text display"
              }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "hero-actions",
          "name": "Hero Actions",
          "description": "Primary and secondary calls to action.",
          "styleRefs": ["screen.web-home.hero-actions"],
          "uses": [
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Primary signup command",
              "binding": { "slot": "cta", "variant": "primary", "copy": "Start free trial", "layout": "row center fit" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Secondary demo command",
              "binding": { "slot": "cta", "variant": "outline", "copy": "Watch the 2-min demo", "layout": "row center fit" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "hero-note",
          "name": "Hero Note",
          "description": "Reassurance line under the calls to action.",
          "styleRefs": ["screen.web-home.hero-note"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Reassurance microcopy",
              "binding": { "slot": "note", "variant": "flat", "copy": "Free for 14 days · No credit card required", "layout": "center text eyebrow" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "product-frame",
          "name": "Product Frame",
          "description": "Product screenshot placeholder anchoring the hero.",
          "styleRefs": ["screen.web-home.product-frame"],
          "uses": [
            {
              "kind": "state-set",
              "id": "media-card/variant",
              "reason": "Product visual",
              "binding": { "slot": "visual", "variant": "cover", "copy": "Live funnel view | Sessions streaming in as they happen", "data": "marketing.heroMedia", "layout": "wide" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "features-heading",
          "name": "Features Heading",
          "description": "Introduction to the feature grid.",
          "styleRefs": ["screen.web-home.features-heading"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Feature section heading",
              "binding": { "slot": "heading", "variant": "flat", "copy": "Why teams switch | Answers at the speed of shipping", "layout": "center narrow text display" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "feature-grid",
          "name": "Feature Grid",
          "description": "Three core product capabilities.",
          "styleRefs": ["screen.web-home.feature-grid"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Live funnels feature",
              "binding": { "slot": "features", "variant": "default", "copy": "Live funnels | Conversion in real time | Watch drop-off move the moment you ship — not next Tuesday.", "layout": "grid-3 wide" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Query explorer feature",
              "binding": { "slot": "features", "variant": "default", "copy": "No-SQL explorer | Ask in plain language | Slice any event stream by cohort, device, or release without writing a line.", "layout": "grid-3 wide" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Smart alerts feature",
              "binding": { "slot": "features", "variant": "default", "copy": "Alerts that think | Signal, not noise | Pulse learns each metric's rhythm and only pages you when it truly breaks.", "layout": "grid-3 wide" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "proof-band",
          "name": "Proof Band",
          "description": "Adoption and reliability statistics.",
          "styleRefs": ["screen.web-home.proof-band"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Volume statistic",
              "binding": { "slot": "proof", "variant": "flat", "copy": "Events tracked monthly | 4.2B", "layout": "grid-3 wide stat text center" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Adoption statistic",
              "binding": { "slot": "proof", "variant": "flat", "copy": "Teams shipping with Pulse | 312", "layout": "grid-3 wide stat text center" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Reliability statistic",
              "binding": { "slot": "proof", "variant": "flat", "copy": "Ingest uptime, trailing year | 99.98%", "layout": "grid-3 wide stat text center" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "testimonial",
          "name": "Testimonial",
          "description": "Customer quote with attribution.",
          "styleRefs": ["screen.web-home.testimonial"],
          "uses": [
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Customer proof quote",
              "binding": { "slot": "quote", "variant": "default", "copy": "“We found our biggest drop-off in twenty minutes. It had been costing us six figures a quarter.” | Maya Chen · Head of Growth, Loopwork", "layout": "narrow center quote" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        },
        {
          "id": "footer-cta",
          "name": "Footer CTA",
          "description": "Closing call to action.",
          "styleRefs": ["screen.web-home.footer-cta"],
          "uses": [
            {
              "kind": "state-set",
              "id": "separator/emphasis",
              "reason": "Footer divider",
              "binding": { "slot": "footer", "variant": "subtle", "layout": "footer center" }
            },
            {
              "kind": "state-set",
              "id": "card/variant",
              "reason": "Closing headline",
              "binding": { "slot": "footer", "variant": "flat", "copy": "Ready when you are | Start seeing your product clearly | Connected to your event stream in one afternoon.", "layout": "center narrow text display" }
            },
            {
              "kind": "state-set",
              "id": "button/variant",
              "reason": "Closing signup command",
              "binding": { "slot": "footer", "variant": "gradient", "copy": "Get started free", "layout": "center fit" }
            }
          ],
          "prototypeOnly": false,
          "notes": [],
          "implementationHints": []
        }
      ]
    }
  ]
}
