{
  "schemaVersion": "1.0.0",
  "projectId": "starter-app",
  "tokenGroups": [
    {
      "id": "color",
      "name": "Color Roles",
      "description": "Replace values with app-owned color roles while keeping stable semantic names.",
      "styleRefs": ["tokens.color"],
      "notes": ["These are neutral Blueprint defaults. A new app should change the values, not the role names, unless its design language needs different semantics."],
      "tokens": [
        {
          "id": "background",
          "name": "Background",
          "type": "color",
          "value": "#0b1118",
          "description": "Canvas and app background role.",
          "styleRef": "--app-color-background"
        },
        {
          "id": "surface",
          "name": "Surface",
          "type": "color",
          "value": "#111821",
          "description": "Default component surface.",
          "styleRef": "--app-color-surface"
        },
        {
          "id": "foreground",
          "name": "Foreground",
          "type": "color",
          "value": "#eef3f8",
          "description": "Primary text and icon color.",
          "styleRef": "--app-color-foreground"
        },
        {
          "id": "muted",
          "name": "Muted Foreground",
          "type": "color",
          "value": "#8c9aaa",
          "description": "Secondary text, captions, and metadata.",
          "styleRef": "--app-color-muted"
        },
        {
          "id": "primary",
          "name": "Primary",
          "type": "color",
          "value": "#e8edf5",
          "description": "Primary command role.",
          "styleRef": "--app-color-primary"
        },
        {
          "id": "secondary",
          "name": "Secondary",
          "type": "color",
          "value": "#9eacba",
          "description": "Secondary command and supporting accent role.",
          "styleRef": "--app-color-secondary"
        },
        {
          "id": "accent",
          "name": "Accent",
          "type": "color",
          "value": "#8aa3c7",
          "description": "Focus, highlight, and non-primary accent role.",
          "styleRef": "--app-color-accent"
        },
        {
          "id": "destructive",
          "name": "Destructive",
          "type": "color",
          "value": "#e66b6b",
          "description": "Negative or destructive action role.",
          "styleRef": "--app-color-destructive"
        },
        {
          "id": "success",
          "name": "Success",
          "type": "color",
          "value": "#73b98f",
          "description": "Positive outcome role.",
          "styleRef": "--app-color-success"
        },
        {
          "id": "warning",
          "name": "Warning",
          "type": "color",
          "value": "#d7a760",
          "description": "Attention or caution role.",
          "styleRef": "--app-color-warning"
        }
      ]
    },
    {
      "id": "space",
      "name": "Spacing Scale",
      "description": "Reusable spacing decisions for mobile-scale primitives.",
      "styleRefs": ["tokens.space"],
      "notes": ["Keep spacing tokens role-based so screens can be recomposed quickly in any app."],
      "tokens": [
        {
          "id": "control-x",
          "name": "Control Inline Padding",
          "type": "space",
          "value": "14px",
          "description": "Horizontal padding for buttons and inputs.",
          "styleRef": "--app-space-control-x"
        },
        {
          "id": "row",
          "name": "Row Gap",
          "type": "space",
          "value": "12px",
          "description": "Gap between leading, body, and trailing row slots.",
          "styleRef": "--app-space-row"
        },
        {
          "id": "section",
          "name": "Section Gap",
          "type": "space",
          "value": "24px",
          "description": "Vertical rhythm between screen sections.",
          "styleRef": "--app-space-section"
        }
      ]
    },
    {
      "id": "shape",
      "name": "Shape",
      "description": "Radius and elevation tokens for primitives.",
      "styleRefs": ["tokens.shape"],
      "notes": ["Blueprint supplies the scale; app teams own final values."],
      "tokens": [
        {
          "id": "radius-sm",
          "name": "Small Radius",
          "type": "radius",
          "value": "6px",
          "description": "Small chips and inner media.",
          "styleRef": "--app-radius-sm"
        },
        {
          "id": "radius-md",
          "name": "Medium Radius",
          "type": "radius",
          "value": "9px",
          "description": "Buttons and inputs.",
          "styleRef": "--app-radius-md"
        },
        {
          "id": "radius-lg",
          "name": "Large Radius",
          "type": "radius",
          "value": "14px",
          "description": "Cards, rows, and panels.",
          "styleRef": "--app-radius-lg"
        },
        {
          "id": "shadow-panel",
          "name": "Panel Shadow",
          "type": "shadow",
          "value": "0 18px 42px rgba(0,0,0,0.28)",
          "description": "Default dark-canvas panel elevation.",
          "styleRef": "--app-shadow-panel"
        }
      ]
    },
    {
      "id": "typography",
      "name": "Typography Roles",
      "description": "Functional type roles for text primitives.",
      "styleRefs": ["tokens.typography"],
      "notes": ["Replace font families and sizes per app while preserving role names for extraction."],
      "tokens": [
        {
          "id": "display",
          "name": "Display",
          "type": "typography",
          "value": "800 30px/1 system-ui",
          "description": "High-emphasis display text.",
          "styleRef": "--app-type-display"
        },
        {
          "id": "body",
          "name": "Body",
          "type": "typography",
          "value": "400 14px/1.5 system-ui",
          "description": "Readable body copy.",
          "styleRef": "--app-type-body"
        },
        {
          "id": "label",
          "name": "Label",
          "type": "typography",
          "value": "800 10px/1.2 system-ui",
          "description": "Eyebrows, captions, badges, and metadata.",
          "styleRef": "--app-type-label"
        }
      ]
    },
    {
      "id": "motion",
      "name": "Motion",
      "description": "Interaction timing roles for primitive states.",
      "styleRefs": ["tokens.motion"],
      "notes": ["Keep motion tokens explicit so prototype behavior can be carried into implementation."],
      "tokens": [
        {
          "id": "press",
          "name": "Press Feedback",
          "type": "motion",
          "value": "120ms ease-out",
          "description": "Tap/press feedback timing.",
          "styleRef": "--app-motion-press"
        },
        {
          "id": "state",
          "name": "State Change",
          "type": "motion",
          "value": "160ms ease",
          "description": "Toggle, focus, and loading state timing.",
          "styleRef": "--app-motion-state"
        }
      ]
    }
  ]
}
