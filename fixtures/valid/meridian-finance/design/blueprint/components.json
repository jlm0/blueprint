        {
          "kind": "primitive",
          "id": "tabs",
          "reason": "Primary section navigation.",
          "binding": {
            "slot": "sections",
            "state": "first-selected, second-selected"
          }
        },
        {
          "kind": "primitive",
          "id": "input",
          "reason": "Global search.",
          "binding": {
            "slot": "search",
            "variant": "filled",
            "state": "empty"
