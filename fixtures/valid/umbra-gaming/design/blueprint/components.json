          "status": "source",
          "sourceAnchor": "prototype/components/pass-track.css"
        }
      ],
      "notes": [
        "Compact drops the reward rail and shows XP gained this match in bone over the lime base."
      ],
      "prototypeOnly": false,
      "implementationHints": [],
      "implementationTargets": [
