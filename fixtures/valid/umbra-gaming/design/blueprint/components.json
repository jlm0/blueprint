    {
      "id": "pass-track",
      "name": "Pass Track",
      "description": "Season pass progress: current tier, XP to the next tier, the reward rail around it, and the next reward.",
      "uses": [
        {
          "kind": "primitive",
          "id": "badge",
          "reason": "Pass ownership.",
          "binding": {
            "slot": "ownership",
            "variant": "accent",
            "copy": "Premium"
          }
        },
        {
          "kind": "primitive",
          "id": "progress",
          "reason": "XP toward the next tier.",
          "binding": {
            "slot": "meter",
            "state": "value",
            "data": "pass.xp / pass.xpForNextTier"
          }
        }
      ],
      "tokenGroupIds": [
        "color",
        "space",
        "shape",
        "typography"
      ],
      "styleRefs": [
