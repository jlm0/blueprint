{
  "schemaVersion": "1.0.0",
  "projectId": "nowwhat-waitlist-proof",
  "components": [
    {
      "id": "site-header",
      "name": "Public Site Header",
      "description": "Reusable NowWhat public header with the brand destination and waitlist/tester navigation.",
      "uses": [
        { "kind": "primitive", "id": "brand-link", "reason": "Canonical public brand destination.", "binding": { "slot": "brand", "state": "default", "copy": "nowwhat" } },
        { "kind": "primitive", "id": "navigation-action", "reason": "Canonical public navigation treatment.", "binding": { "slot": "navigation", "state": "default", "copy": "Waitlist; Tester login" } }
      ],
      "tokenGroupIds": ["color", "space", "shape", "typography"],
      "prototype": { "source": "prototype/components/site-header.html", "styles": ["prototype/components/site-header.css"], "slots": ["brand", "navigation"], "states": ["initial"] }
    },
    {
      "id": "email-signup-form",
      "name": "Email Signup Form",
      "description": "Reusable static initial-state email capture surface composed from the canonical field and submit action.",
      "uses": [
        { "kind": "primitive", "id": "text-input", "reason": "Canonical labeled email field.", "binding": { "slot": "email", "state": "empty", "copy": "you@example.com" } },
        { "kind": "primitive", "id": "primary-action", "reason": "Canonical invitation submit action.", "binding": { "slot": "submit", "state": "default", "copy": "Save my spot" } }
      ],
      "tokenGroupIds": ["color", "space", "shape", "typography", "motion"],
      "prototype": { "source": "prototype/components/email-signup-form.html", "styles": ["prototype/components/email-signup-form.css"], "slots": ["email", "submit", "status"], "states": ["initial"] }
    },
    {
      "id": "seller-trust-proof",
      "name": "Seller Trust Proof",
      "description": "Reusable seller-count, daily-change, and Whatnot-login reassurance assembly.",
      "uses": [
        { "kind": "primitive", "id": "seller-avatar", "reason": "Canonical decorative seller initial treatment.", "binding": { "slot": "seller avatars", "state": "default", "data": "M, J, A, S, R" } },
        { "kind": "primitive", "id": "status-chip", "reason": "Canonical positive proof treatment.", "binding": { "slot": "daily change", "state": "default", "copy": "+12 today" } }
      ],
      "tokenGroupIds": ["color", "space", "shape", "typography"],
      "prototype": { "source": "prototype/components/seller-trust-proof.html", "styles": ["prototype/components/seller-trust-proof.css"], "slots": ["avatars", "count", "change", "reassurance"], "states": ["initial"] }
    },
    {
      "id": "product-preview",
      "name": "Seller Workspace Preview",
      "description": "Reusable static NowWhat workspace preview with show momentum, chat signals, and fulfillment panels.",
      "uses": [
        { "kind": "primitive", "id": "status-chip", "reason": "Canonical status and data-chip treatments within the preview.", "binding": { "slot": "statuses", "state": "default", "copy": "Ended; +18% vs avg; chat signals; fulfillment lots" } }
      ],
      "tokenGroupIds": ["color", "space", "shape", "typography"],
      "prototype": { "source": "prototype/components/product-preview.html", "styles": ["prototype/components/product-preview.css"], "slots": ["window status", "momentum", "chat signals", "fulfillment queue"], "states": ["initial"] }
    },
    {
      "id": "feature-action-cards",
      "name": "Feature Action Cards",
      "description": "Reusable below-hero continuation that explains capture, analysis, buyer-signal, and fulfillment value.",
      "uses": [],
      "tokenGroupIds": ["color", "space", "shape", "typography", "motion"],
      "prototype": { "source": "prototype/components/feature-action-cards.html", "styles": ["prototype/components/feature-action-cards.css"], "slots": ["features"], "states": ["initial"] }
    },
    {
      "id": "site-footer",
      "name": "Public Site Footer",
      "description": "Reusable public-alpha footer with tester access and delivery reassurance.",
      "uses": [
        { "kind": "primitive", "id": "navigation-action", "reason": "Canonical tester navigation destination.", "binding": { "slot": "tester link", "state": "default", "copy": "Tester login" } }
      ],
      "tokenGroupIds": ["color", "space", "typography"],
      "prototype": { "source": "prototype/components/site-footer.html", "styles": ["prototype/components/site-footer.css"], "slots": ["alpha note", "tester link", "delivery note"], "states": ["initial"] }
    }
