{
  "schemaVersion": "1.0.0",
  "projectId": "atlas-pay",
  "primitives": [
    {
      "id": "review-button",
      "name": "Review Button",
      "description": "Command primitive for approving or holding payment batches.",
      "tokenGroupIds": ["color", "space"],
      "styleRefs": ["primitive.review-button", ".atlas-review-button"],
      "notes": ["Atlas owns this primitive even though Blueprint can inspect it generically."],
      "prototypeOnly": false,
      "implementationHints": ["Map approved and hold states to the target app's command system."],
      "stateSets": [
        {
          "id": "decision",
          "name": "Decision States",
          "description": "Payment review command states.",
          "styleRefs": ["primitive.review-button.decision"],
          "states": [
            {
              "id": "approve",
              "name": "Approve",
              "tokens": ["color.accent", "space.row"],
              "prototypeOnly": false,
              "notes": ["Positive review action."],
              "implementationHints": ["Require confirmation in production if money moves immediately."]
            },
            {
              "id": "hold",
              "name": "Hold",
              "tokens": ["color.risk", "space.row"],
              "prototypeOnly": false,
              "notes": ["Exception review action."],
              "implementationHints": ["Pair with an explicit reason field in production."]
            }
          ]
        }
      ]
    },
    {
      "id": "amount-row",
      "name": "Amount Row",
      "description": "Dense row primitive for payment amount and counterparty data.",
      "tokenGroupIds": ["color", "space"],
      "styleRefs": ["primitive.amount-row", ".atlas-amount-row"],
      "notes": ["Shows that primitive naming and semantics are app-owned."],
      "prototypeOnly": false,
      "implementationHints": ["Keep numeric alignment stable across currencies."],
      "stateSets": [
        {
          "id": "status",
          "name": "Status States",
          "description": "Review status states for rows.",
          "styleRefs": ["primitive.amount-row.status"],
          "states": [
            {
              "id": "normal",
              "name": "Normal",
              "tokens": ["color.ink", "space.row"],
              "prototypeOnly": false,
              "notes": ["Default row state."],
              "implementationHints": ["Use tabular numbers when available."]
            },
            {
              "id": "risk",
              "name": "Risk",
              "tokens": ["color.risk", "space.row"],
              "prototypeOnly": false,
              "notes": ["Exception row state."],
              "implementationHints": ["Expose reason text beyond color."]
            }
          ]
        }
      ]
    }
  ]
}
