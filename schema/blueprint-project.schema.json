{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.local/schema/blueprint-project.schema.json",
  "title": "Blueprint Project Structured Files",
  "description": "Machine-readable artifact aligned with the current TypeScript structured-file contract. Production handoff semantics remain owned by the Agent Handoff Contract workstream; this schema exposes the current fields for editors, agents, and package consumers.",
  "type": "object",
  "required": ["manifest", "tokens", "primitives", "screens"],
  "additionalProperties": false,
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "tokens": { "$ref": "#/$defs/tokenFile" },
    "primitives": { "$ref": "#/$defs/primitiveFile" },
    "components": { "$ref": "#/$defs/componentFile" },
    "screens": { "$ref": "#/$defs/screenFile" },
    "explorations": { "$ref": "#/$defs/explorationFile" }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "project", "defaultBoardId", "boards", "framePresets"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "handoffContractVersion": { "type": "string" },
        "project": { "$ref": "#/$defs/project" },
        "defaultBoardId": { "type": "string" },
        "boards": {
          "type": "array",
          "items": { "$ref": "#/$defs/board" }
        },
        "framePresets": {
          "type": "array",
          "items": { "$ref": "#/$defs/framePreset" }
        },
        "prototypeHost": { "$ref": "#/$defs/prototypeHost" }
      }
    },
    "prototypeHost": {
      "type": "object",
      "required": ["assetRoots", "network", "scripts"],
      "properties": {
        "assetRoots": { "$ref": "#/$defs/stringArray" },
        "network": { "const": "deny" },
        "scripts": { "const": "none" }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "description", "owner", "sourceRoot"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "sourceRoot": { "type": "string" }
      }
    },
    "board": {
      "type": "object",
      "required": ["id", "kind", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["primitives", "screens"] },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "framePreset": {
      "type": "object",
      "required": ["id", "name", "type", "width", "height", "safeArea"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["mobile", "desktop"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "safeArea": {
          "type": "object",
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          }
        }
      }
    },
    "tokenFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "tokenGroups"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "tokenGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenGroup" }
        }
      }
    },
    "tokenGroup": {
      "type": "object",
      "required": ["id", "name", "description", "styleRefs", "notes", "tokens"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/designToken" }
        }
      }
    },
    "designToken": {
      "type": "object",
      "required": ["id", "name", "type", "value", "description", "styleRef"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["color", "space", "radius", "typography", "shadow", "motion"] },
        "value": { "type": "string" },
        "description": { "type": "string" },
        "styleRef": { "type": "string" }
      }
    },
    "primitiveFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "primitives"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "primitives": {
          "type": "array",
          "items": { "$ref": "#/$defs/primitive" }
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": ["id", "name", "description", "tokenGroupIds", "styleRefs", "notes", "prototypeOnly", "implementationHints", "stateSets"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tokenGroupIds": { "$ref": "#/$defs/stringArray" },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundaryDependency" }
        },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "notes": { "$ref": "#/$defs/stringArray" },
        "prototypeOnly": { "type": "boolean" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        },
        "prototype": { "$ref": "#/$defs/primitivePrototype" },
        "stateSets": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateSet" }
        }
      }
    },
    "primitivePrototype": {
      "type": "object",
      "required": ["source", "styles", "states", "slots", "variants", "accessibilityIntent", "tokenRoles"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "states": { "$ref": "#/$defs/stringArray" },
        "slots": { "$ref": "#/$defs/stringArray" },
        "variants": { "$ref": "#/$defs/stringArray" },
        "accessibilityIntent": { "type": "string" },
        "tokenRoles": { "type": "object", "additionalProperties": { "type": "string" } },
        "renderedUses": { "$ref": "#/$defs/prototypeUses" },
        "localValueExceptions": { "$ref": "#/$defs/localValueExceptions" }
      }
    },
    "stateSet": {
      "type": "object",
      "required": ["id", "name", "description", "styleRefs", "states"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/primitiveState" }
        }
      }
    },
    "primitiveState": {
      "type": "object",
      "required": ["id", "name", "tokens", "prototypeOnly", "notes", "implementationHints"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tokens": { "$ref": "#/$defs/stringArray" },
        "tokenRoles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "prototypeOnly": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "implementationHints": { "$ref": "#/$defs/stringArray" }
      }
    },
    "screenFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "screens"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "screens": {
          "type": "array",
          "items": { "$ref": "#/$defs/screen" }
        }
      }
    },
    "explorationFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "explorations"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "explorations": {
          "type": "array",
          "items": { "$ref": "#/$defs/exploration" }
        }
      }
    },
    "exploration": {
      "type": "object",
      "required": ["id", "title", "intent", "lifecycle", "target", "candidates"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "intent": { "type": "string", "minLength": 1, "maxLength": 160 },
        "lifecycle": { "enum": ["active", "archived", "promoted"] },
        "target": { "$ref": "#/$defs/explorationTarget" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/explorationCandidate" }
        },
        "selectedCandidateId": { "$ref": "#/$defs/safeId" },
        "promotedScreenId": { "type": "string" }
      }
    },
    "explorationTarget": {
      "type": "object",
      "required": ["screenId", "state", "framePresetId", "baseDigest", "baseline"],
      "properties": {
        "screenId": { "type": "string" },
        "state": { "type": "string" },
        "framePresetId": { "type": "string" },
        "baseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseline": { "$ref": "#/$defs/explorationBaseline" }
      }
    },
    "explorationBaseline": {
      "type": "object",
      "required": ["screen", "prototype"],
      "properties": {
        "screen": { "$ref": "#/$defs/screen" },
        "prototype": { "$ref": "#/$defs/explorationPrototype" }
      }
    },
    "explorationCandidate": {
      "type": "object",
      "required": ["id", "label", "prototype"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "prototype": { "$ref": "#/$defs/explorationPrototype" }
      }
    },
    "explorationPrototype": {
      "type": "object",
      "required": ["source", "styles", "assetRefs"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "assetRefs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "componentFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "components"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "description", "uses", "tokenGroupIds", "prototype"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "uses": { "type": "array", "items": { "$ref": "#/$defs/boundaryDependency" } },
        "tokenGroupIds": { "$ref": "#/$defs/stringArray" },
        "prototype": { "$ref": "#/$defs/componentPrototype" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": { "type": "array", "items": { "$ref": "#/$defs/styleEvidence" } },
        "notes": { "$ref": "#/$defs/stringArray" },
        "prototypeOnly": { "type": "boolean" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "implementationTargets": { "type": "array", "items": { "$ref": "#/$defs/implementationTarget" } }
      }
    },
    "componentPrototype": {
      "type": "object",
      "required": ["source", "styles", "states", "slots"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "states": { "$ref": "#/$defs/stringArray" },
        "slots": { "$ref": "#/$defs/stringArray" },
        "renderedUses": { "$ref": "#/$defs/prototypeUses" },
        "localValueExceptions": { "$ref": "#/$defs/localValueExceptions" }
      }
    },
    "screen": {
      "type": "object",
      "required": ["id", "name", "description", "framePresetId", "styleRefs", "notes", "prototypeOnly", "implementationHints", "sections"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "framePresetId": { "type": "string" },
        "flow": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "notes": { "$ref": "#/$defs/stringArray" },
        "prototypeOnly": { "type": "boolean" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "productionRelationship": { "$ref": "#/$defs/productionRelationship" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        },
        "prototype": { "$ref": "#/$defs/screenPrototype" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenSection" }
        }
      }
    },
    "screenPrototype": {
      "type": "object",
      "required": ["source", "styles", "states", "assetRefs", "reviewConditions"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "states": { "$ref": "#/$defs/stringArray" },
        "assetRefs": { "$ref": "#/$defs/stringArray" },
        "reviewConditions": { "type": "array", "items": { "$ref": "#/$defs/reviewCondition" } },
        "renderedUses": { "$ref": "#/$defs/prototypeUses" },
        "localValueExceptions": { "$ref": "#/$defs/localValueExceptions" }
      }
    },
    "reviewCondition": {
      "type": "object",
      "required": ["id", "framePresetId", "state"],
      "properties": {
        "id": { "type": "string" },
        "framePresetId": { "type": "string" },
        "state": { "type": "string" }
      }
    },
    "prototypeUses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "enum": ["primitive", "component"] },
          "id": { "type": "string" }
        }
      }
    },
    "localValueExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "value", "reason"],
        "properties": {
          "property": { "type": "string" },
          "value": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "screenSection": {
      "type": "object",
      "required": ["id", "name", "description", "styleRefs", "uses", "prototypeOnly", "notes", "implementationHints"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundaryDependency" }
        },
        "prototypeOnly": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        }
      }
    },
    "boundaryDependency": {
      "type": "object",
      "required": ["kind", "id", "reason"],
      "properties": {
        "kind": { "enum": ["token-group", "primitive", "state-set", "component", "screen", "section"] },
        "id": { "type": "string" },
        "reason": { "type": "string" },
        "binding": { "$ref": "#/$defs/compositionBinding" }
      }
    },
    "productionRelationship": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["new-route", "existing-route", "state-of-existing-screen", "variant-of-existing-screen", "section-replacement", "embedded-flow"]
        },
        "routePath": { "type": "string" },
        "targetScreenId": { "type": "string" },
        "replacedSectionId": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "compositionBinding": {
      "type": "object",
      "properties": {
        "slot": { "type": "string" },
        "state": { "type": "string" },
        "variant": { "type": "string" },
        "prop": { "type": "string" },
        "copy": { "type": "string" },
        "data": { "type": "string" },
        "layout": { "type": "string" },
        "accessibility": { "type": "string" }
      }
    },
    "implementationTarget": {
      "type": "object",
      "required": ["platform", "framework", "candidatePath", "symbolName", "operationIntent", "propMapping", "stateMapping", "tokenAdapter", "testPaths", "storyPaths", "unresolvedDecisions"],
      "properties": {
        "platform": { "type": "string" },
        "framework": { "type": "string" },
        "candidatePath": { "type": "string" },
        "symbolName": { "type": "string" },
        "operationIntent": { "type": "string" },
        "propMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "stateMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tokenAdapter": { "type": "string" },
        "testPaths": { "$ref": "#/$defs/stringArray" },
        "storyPaths": { "$ref": "#/$defs/stringArray" },
        "unresolvedDecisions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "styleEvidence": {
      "type": "object",
      "required": ["styleRef", "status"],
      "properties": {
        "styleRef": { "type": "string" },
        "status": { "enum": ["source", "linked-artifact-pending", "unresolved"] },
        "sourceAnchor": { "type": "string" },
        "artifactRef": { "type": "string" },
        "renderedSnippet": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "readinessReport": {
      "type": "object",
      "required": ["projectId", "fidelityTier", "prototypeSources", "tier", "items", "blockers"],
      "properties": {
        "projectId": { "type": "string" },
        "fidelityTier": { "enum": ["baseline-compatible", "high-fidelity"] },
        "prototypeSources": { "$ref": "#/$defs/stringArray" },
        "tier": { "enum": ["ready", "pending", "unresolved", "blocked"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessItem" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessItem" }
        }
      }
    },
    "readinessItem": {
      "type": "object",
      "required": ["path", "severity", "source", "message"],
      "properties": {
        "path": { "type": "string" },
        "severity": { "enum": ["ready", "pending", "unresolved", "blocker"] },
        "source": { "enum": ["resolved", "declared", "declared-missing-artifact", "synthesized-missing"] },
        "message": { "type": "string" },
        "artifactRef": { "type": "string" },
        "artifactExists": { "type": "boolean" }
      }
    },
    "deepHandoffPacket": {
      "type": "object",
      "required": ["extraction", "boundaries", "resolvedTokens", "tokenUsage"],
      "properties": {
        "extraction": { "type": "object" },
        "boundaries": { "type": "array" },
        "resolvedTokens": { "type": "array" },
        "tokenUsage": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenUsage" }
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "required": ["tokenId", "role", "boundaryId", "boundaryKind", "styleRef"],
      "properties": {
        "tokenId": { "type": "string" },
        "role": { "type": "string" },
        "boundaryId": { "type": "string" },
        "boundaryKind": { "enum": ["project", "board", "token-group", "primitive", "state-set", "component", "screen", "section"] },
        "styleRef": { "type": "string" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
