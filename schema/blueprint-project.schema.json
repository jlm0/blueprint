{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.local/schema/blueprint-project.schema.json",
  "title": "Blueprint Project Structured Files",
  "description": "Machine-readable artifact aligned with the current TypeScript structured-file contract. This schema exposes the current fields for editors, agents, and package consumers.",
  "type": "object",
  "required": ["manifest", "tokens", "primitives", "components", "screens"],
  "additionalProperties": false,
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "tokens": { "$ref": "#/$defs/tokenFile" },
    "primitives": { "$ref": "#/$defs/primitiveFile" },
    "components": { "$ref": "#/$defs/componentFile" },
    "screens": { "$ref": "#/$defs/screenFile" },
    "brand": { "$ref": "#/$defs/brandFile" },
    "explorations": { "$ref": "#/$defs/explorationFile" },
    "history": { "$ref": "#/$defs/screenHistoryFile" }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "project", "defaultBoardId", "boards", "framePresets", "prototypeHost"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "handoffContractVersion": { "type": "string" },
        "project": { "$ref": "#/$defs/project" },
        "defaultBoardId": { "type": "string" },
        "boards": {
          "type": "array",
          "items": { "$ref": "#/$defs/board" }
        },
        "framePresets": {
          "type": "array",
          "items": { "$ref": "#/$defs/framePreset" }
        },
        "prototypeHost": { "$ref": "#/$defs/prototypeHost" }
      }
    },
    "prototypeHost": {
      "type": "object",
      "required": ["assetRoots", "network", "scripts"],
      "properties": {
        "assetRoots": { "$ref": "#/$defs/stringArray" },
        "network": { "const": "deny" },
        "scripts": { "const": "none" }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "description", "owner", "sourceRoot"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "sourceRoot": { "type": "string" }
      }
    },
    "board": {
      "type": "object",
      "required": ["id", "kind", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["primitives", "screens"] },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "framePreset": {
      "type": "object",
      "required": ["id", "name", "type", "width", "height", "safeArea"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["mobile", "desktop"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "safeArea": {
          "type": "object",
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          }
        }
      }
    },
    "tokenFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "tokenGroups"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "tokenGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenGroup" }
        }
      }
    },
    "tokenGroup": {
      "type": "object",
      "required": ["id", "name", "description", "styleRefs", "notes", "tokens"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/designToken" }
        }
      }
    },
    "designToken": {
      "type": "object",
      "required": ["id", "name", "type", "value", "description", "styleRef"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["color", "space", "size", "radius", "typography", "shadow", "motion"] },
        "value": { "type": "string" },
        "description": { "type": "string" },
        "styleRef": { "type": "string" }
      }
    },
    "primitiveFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectId", "primitives"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "projectId": { "type": "string" },
        "primitives": {
          "type": "array",
          "items": { "$ref": "#/$defs/primitive" }
        }
      }
    },
    "primitive": {
      "description": "One of the closed set of Blueprint primitives, in the shared reusable shape.",
      "$ref": "#/$defs/reusable"
    },
    "brandFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "name", "marks"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "personality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "voice": {
          "type": "object",
          "required": ["summary", "do", "dont"],
          "properties": {
            "summary": { "type": "string" },
            "do": { "$ref": "#/$defs/stringArray" },
            "dont": { "$ref": "#/$defs/stringArray" }
          }
        },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/brandMark" }
        },
        "usage": {
          "type": "object",
          "required": ["do", "dont"],
          "properties": {
            "do": { "$ref": "#/$defs/stringArray" },
            "dont": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "brandMark": {
      "type": "object",
      "required": ["id", "name", "role", "description", "source", "variants", "clearSpace", "minimumSize"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "enum": ["mark", "wordmark", "lockup", "app-icon"] },
        "description": { "type": "string" },
        "source": {
          "type": "string",
          "pattern": "\\.svg$"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "background", "foreground"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "background": { "type": "string" },
              "foreground": { "type": "string" },
              "accent": { "type": "string" }
            }
          }
        },
        "clearSpace": {
          "type": "object",
          "required": ["ratio", "basis"],
          "properties": {
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "basis": { "enum": ["height", "width"] },
            "note": { "type": "string" }
          }
        },
        "minimumSize": {
          "type": "object",
          "required": ["px", "axis"],
          "properties": {
            "px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "axis": { "enum": ["height", "width"] },
            "note": { "type": "string" }
          }
        }
      }
    },
    "declaredGroup": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "screenFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "pages", "screens"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaredGroup" }
        },
        "screens": {
          "type": "array",
          "items": { "$ref": "#/$defs/screen" }
        }
      }
    },
    "explorationFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "explorations"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "explorations": {
          "type": "array",
          "items": { "$ref": "#/$defs/exploration" }
        }
      }
    },
    "explorationRecordFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "exploration"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "exploration": { "$ref": "#/$defs/exploration" }
      }
    },
    "exploration": {
      "type": "object",
      "required": ["id", "title", "intent", "lifecycle", "target", "candidates"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lifecycle": { "enum": ["active", "archived", "promoted"] },
        "target": { "$ref": "#/$defs/explorationTarget" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/explorationCandidate" }
        },
        "selectedCandidateId": { "$ref": "#/$defs/safeId" },
        "promotedScreenId": { "type": "string" }
      }
    },
    "explorationTarget": {
      "type": "object",
      "required": ["screenId", "state", "framePresetId", "baseDigest", "baseline"],
      "properties": {
        "screenId": { "type": "string" },
        "state": { "type": "string" },
        "framePresetId": { "type": "string" },
        "baseDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline": { "$ref": "#/$defs/explorationBaseline" }
      }
    },
    "explorationBaseline": {
      "type": "object",
      "required": ["screen", "prototype"],
      "properties": {
        "screen": { "$ref": "#/$defs/screen" },
        "prototype": { "$ref": "#/$defs/explorationPrototype" }
      }
    },
    "explorationCandidate": {
      "type": "object",
      "required": ["id", "label", "prototype"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "prototype": { "$ref": "#/$defs/explorationPrototype" }
      }
    },
    "explorationPrototype": {
      "type": "object",
      "required": ["source", "styles", "assetRefs"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "assetRefs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "screenHistoryFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "entries"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenHistoryEntry" }
        }
      }
    },
    "screenHistoryRecordFile": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "entry"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "projectId": { "type": "string" },
        "entry": { "$ref": "#/$defs/screenHistoryEntry" }
      }
    },
    "screenHistoryEntry": {
      "type": "object",
      "required": ["screenId", "version", "state", "framePresetId", "screen", "replacedBy"],
      "properties": {
        "screenId": { "type": "string" },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": { "type": "string" },
        "framePresetId": { "type": "string" },
        "screen": { "$ref": "#/$defs/screen" },
        "replacedBy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "explorationId", "candidateId"],
              "properties": {
                "type": { "const": "exploration-candidate" },
                "explorationId": { "type": "string" },
                "candidateId": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["type", "version"],
              "properties": {
                "type": { "const": "history-restore" },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "componentFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectId", "groups", "components"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "projectId": { "type": "string" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentGroup" }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "component": {
      "description": "An app-owned component, in the shared reusable shape.",
      "$ref": "#/$defs/reusable"
    },
    "screen": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "framePresetId",
        "page",
        "styleRefs",
        "notes",
        "prototypeOnly",
        "implementationHints",
        "prototype",
        "sections"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": { "type": "string" },
        "framePresetId": { "type": "string" },
        "page": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "notes": { "$ref": "#/$defs/stringArray" },
        "prototypeOnly": { "type": "boolean" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "productionRelationship": { "$ref": "#/$defs/productionRelationship" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        },
        "prototype": { "$ref": "#/$defs/screenPrototype" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenSection" }
        }
      }
    },
    "screenPrototype": {
      "type": "object",
      "required": ["source", "styles", "states", "assetRefs", "reviewConditions"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "states": { "$ref": "#/$defs/stringArray" },
        "assetRefs": { "$ref": "#/$defs/stringArray" },
        "reviewConditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewCondition" }
        },
        "renderedUses": { "$ref": "#/$defs/prototypeUses" },
        "localValueExceptions": { "$ref": "#/$defs/localValueExceptions" }
      }
    },
    "reviewCondition": {
      "type": "object",
      "required": ["id", "framePresetId", "state"],
      "properties": {
        "id": { "type": "string" },
        "framePresetId": { "type": "string" },
        "state": { "type": "string" }
      }
    },
    "prototypeUses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "enum": ["primitive", "component"] },
          "id": { "type": "string" }
        }
      }
    },
    "localValueExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "value", "reason"],
        "properties": {
          "property": { "type": "string" },
          "value": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "screenSection": {
      "type": "object",
      "required": ["id", "name", "description", "styleRefs", "uses", "prototypeOnly", "notes", "implementationHints"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundaryDependency" }
        },
        "prototypeOnly": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        }
      }
    },
    "boundaryDependency": {
      "type": "object",
      "required": ["kind", "id", "reason"],
      "properties": {
        "kind": { "enum": ["token-group", "primitive", "component", "screen", "section"] },
        "id": { "type": "string" },
        "reason": { "type": "string" },
        "binding": { "$ref": "#/$defs/compositionBinding" }
      }
    },
    "productionRelationship": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "new-route",
            "existing-route",
            "state-of-existing-screen",
            "variant-of-existing-screen",
            "section-replacement",
            "embedded-flow"
          ]
        },
        "routePath": { "type": "string" },
        "targetScreenId": { "type": "string" },
        "replacedSectionId": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "compositionBinding": {
      "type": "object",
      "properties": {
        "slot": { "type": "string" },
        "state": { "type": "string" },
        "variant": { "type": "string" },
        "prop": { "type": "string" },
        "copy": { "type": "string" },
        "data": { "type": "string" },
        "layout": { "type": "string" },
        "accessibility": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "implementationTarget": {
      "type": "object",
      "required": [
        "platform",
        "framework",
        "candidatePath",
        "symbolName",
        "operationIntent",
        "propMapping",
        "stateMapping",
        "tokenAdapter",
        "testPaths",
        "storyPaths",
        "unresolvedDecisions"
      ],
      "properties": {
        "platform": { "type": "string" },
        "framework": { "type": "string" },
        "candidatePath": { "type": "string" },
        "symbolName": { "type": "string" },
        "operationIntent": { "type": "string" },
        "propMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "stateMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tokenAdapter": { "type": "string" },
        "testPaths": { "$ref": "#/$defs/stringArray" },
        "storyPaths": { "$ref": "#/$defs/stringArray" },
        "unresolvedDecisions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "styleEvidence": {
      "type": "object",
      "required": ["styleRef", "status"],
      "properties": {
        "styleRef": { "type": "string" },
        "status": { "enum": ["source", "linked-artifact-pending", "unresolved"] },
        "sourceAnchor": { "type": "string" },
        "artifactRef": { "type": "string" },
        "renderedSnippet": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "readinessReport": {
      "type": "object",
      "required": ["projectId", "prototypeSources", "tier", "items", "blockers"],
      "properties": {
        "projectId": { "type": "string" },
        "prototypeSources": { "$ref": "#/$defs/stringArray" },
        "tier": { "enum": ["ready", "pending", "unresolved", "blocked"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessItem" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessItem" }
        }
      }
    },
    "readinessItem": {
      "type": "object",
      "required": ["path", "severity", "source", "message"],
      "properties": {
        "path": { "type": "string" },
        "severity": { "enum": ["ready", "pending", "unresolved", "blocker"] },
        "source": { "enum": ["resolved", "declared", "declared-missing-artifact", "synthesized-missing"] },
        "message": { "type": "string" },
        "artifactRef": { "type": "string" },
        "artifactExists": { "type": "boolean" }
      }
    },
    "deepHandoffPacket": {
      "type": "object",
      "required": ["extraction", "boundaries", "resolvedTokens", "tokenUsage"],
      "properties": {
        "extraction": { "type": "object" },
        "boundaries": { "type": "array" },
        "resolvedTokens": { "type": "array" },
        "tokenUsage": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenUsage" }
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "required": ["tokenId", "role", "boundaryId", "boundaryKind", "styleRef"],
      "properties": {
        "tokenId": { "type": "string" },
        "role": { "type": "string" },
        "boundaryId": { "type": "string" },
        "boundaryKind": { "enum": ["project", "board", "token-group", "primitive", "state-set", "component", "screen", "section"] },
        "styleRef": { "type": "string" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "reusable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "group",
        "platforms",
        "uses",
        "variants",
        "sizes",
        "states",
        "unsupported",
        "slots",
        "prototype",
        "tokenGroupIds",
        "tokenRoles",
        "accessibility",
        "notes",
        "implementationHints",
        "implementationTargets",
        "styleRefs",
        "styleEvidence",
        "prototypeOnly"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platform" }
        },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/reusableUse" }
        },
        "variants": { "$ref": "#/$defs/reusableAxis" },
        "sizes": { "$ref": "#/$defs/reusableAxis" },
        "states": { "$ref": "#/$defs/reusableAxis" },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/reusableUnsupported" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/reusableSlot" }
        },
        "prototype": { "$ref": "#/$defs/reusablePrototype" },
        "tokenGroupIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "tokenRoles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": { "$ref": "#/$defs/stringArray" },
        "implementationHints": { "$ref": "#/$defs/stringArray" },
        "implementationTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationTarget" }
        },
        "styleRefs": { "$ref": "#/$defs/stringArray" },
        "styleEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/styleEvidence" }
        },
        "prototypeOnly": { "type": "boolean" }
      }
    },
    "platform": { "enum": ["web", "mobile", "desktop"] },
    "reusableUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "reason"],
      "properties": {
        "kind": { "enum": ["primitive", "component"] },
        "id": { "type": "string" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "reusableAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "values"],
      "properties": {
        "default": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reusableAxisValue" }
        }
      }
    },
    "reusableAxisValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "reusableUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "value", "state", "reason"],
      "properties": {
        "axis": { "enum": ["variant", "size"] },
        "value": { "type": "string" },
        "state": { "type": "string" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "reusableSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "accepts"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(text|graphic|brand-mark|(primitive|component):[a-z0-9]+(?:-[a-z0-9]+)*)$"
          }
        }
      }
    },
    "reusablePrototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "styles", "localValueExceptions"],
      "properties": {
        "source": { "type": "string" },
        "styles": { "$ref": "#/$defs/stringArray" },
        "localValueExceptions": { "$ref": "#/$defs/localValueExceptions" }
      }
    },
    "componentGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
