{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.local/schema/blueprint-project.schema.json",
  "title": "Blueprint Project Structured Files",
  "description": "Machine-readable artifact aligned with the current TypeScript structured-file contract. This schema exposes the current fields for editors, agents, and package consumers.",
  "type": "object",
  "properties": {
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "tokens": {
      "$ref": "#/$defs/tokenFile"
    },
    "primitives": {
      "$ref": "#/$defs/primitiveFile"
    },
    "components": {
      "$ref": "#/$defs/componentFile"
    },
    "screens": {
      "$ref": "#/$defs/screenFile"
    },
    "brand": {
      "$ref": "#/$defs/brandFile"
    },
    "inspo": {
      "$ref": "#/$defs/inspoFile"
    },
    "explorations": {
      "$ref": "#/$defs/explorationFile"
    },
    "history": {
      "$ref": "#/$defs/screenHistoryFile"
    }
  },
  "required": [
    "manifest",
    "tokens",
    "primitives",
    "components",
    "screens"
  ],
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "styleEvidence": {
      "type": "object",
      "properties": {
        "styleRef": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "source",
            "linked-artifact-pending",
            "unresolved"
          ]
        },
        "sourceAnchor": {
          "type": "string"
        },
        "artifactRef": {
          "type": "string"
        },
        "renderedSnippet": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "required": [
        "styleRef",
        "status"
      ]
    },
    "implementationTarget": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "candidatePath": {
          "type": "string"
        },
        "symbolName": {
          "type": "string"
        },
        "operationIntent": {
          "type": "string"
        },
        "propMapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "stateMapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokenAdapter": {
          "type": "string"
        },
        "testPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "storyPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolvedDecisions": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "required": [
        "platform",
        "framework",
        "candidatePath",
        "symbolName",
        "operationIntent",
        "propMapping",
        "stateMapping",
        "tokenAdapter",
        "testPaths",
        "storyPaths",
        "unresolvedDecisions"
      ]
    },
    "localValueExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "property",
          "value",
          "reason"
        ]
      }
    },
    "declaredGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "mobile",
        "desktop"
      ]
    },
    "reusableAxisValue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "reusableAxis": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/reusableAxisValue"
          }
        }
      },
      "required": [
        "default",
        "values"
      ],
      "additionalProperties": false
    },
    "reusableUnsupported": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "variant",
            "size"
          ]
        },
        "value": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "axis",
        "value",
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "reusableSlot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "accepts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(text|graphic|brand-mark|(primitive|component):[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "accepts"
      ],
      "additionalProperties": false
    },
    "reusableUse": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "primitive",
            "component"
          ]
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id",
        "reason"
      ],
      "additionalProperties": false
    },
    "reusablePrototype": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "styles": {
          "$ref": "#/$defs/stringArray"
        },
        "localValueExceptions": {
          "$ref": "#/$defs/localValueExceptions"
        }
      },
      "required": [
        "source",
        "styles",
        "localValueExceptions"
      ],
      "additionalProperties": false
    },
    "reusable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "platforms": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          },
          "uniqueItems": true
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reusableUse"
          }
        },
        "variants": {
          "$ref": "#/$defs/reusableAxis"
        },
        "sizes": {
          "$ref": "#/$defs/reusableAxis"
        },
        "states": {
          "$ref": "#/$defs/reusableAxis"
        },
        "unsupported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reusableUnsupported"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reusableSlot"
          }
        },
        "prototype": {
          "$ref": "#/$defs/reusablePrototype"
        },
        "tokenGroupIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokenRoles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": {
          "$ref": "#/$defs/stringArray"
        },
        "implementationHints": {
          "$ref": "#/$defs/stringArray"
        },
        "implementationTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementationTarget"
          }
        },
        "styleRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "styleEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/styleEvidence"
          }
        },
        "prototypeOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "group",
        "platforms",
        "uses",
        "variants",
        "sizes",
        "states",
        "unsupported",
        "slots",
        "prototype",
        "tokenGroupIds",
        "tokenRoles",
        "accessibility",
        "notes",
        "implementationHints",
        "implementationTargets",
        "styleRefs",
        "styleEvidence",
        "prototypeOnly"
      ],
      "additionalProperties": false
    },
    "component": {
      "description": "An app-owned component, in the shared reusable shape.",
      "$ref": "#/$defs/reusable"
    },
    "componentGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "componentFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "projectId": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentGroup"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "groups",
        "components"
      ],
      "additionalProperties": false
    },
    "brandMark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "mark",
            "wordmark",
            "lockup",
            "app-icon"
          ]
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "\\.svg$"
        },
        "variants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "background": {
                "type": "string"
              },
              "foreground": {
                "type": "string"
              },
              "accent": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "background",
              "foreground"
            ]
          }
        },
        "clearSpace": {
          "type": "object",
          "properties": {
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "basis": {
              "type": "string",
              "enum": [
                "height",
                "width"
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "ratio",
            "basis"
          ]
        },
        "minimumSize": {
          "type": "object",
          "properties": {
            "px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "axis": {
              "type": "string",
              "enum": [
                "height",
                "width"
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "px",
            "axis"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "description",
        "source",
        "variants",
        "clearSpace",
        "minimumSize"
      ]
    },
    "brandFont": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "asset",
            "system"
          ]
        },
        "assets": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "required": [
        "family",
        "source",
        "assets"
      ],
      "additionalProperties": false
    },
    "brandFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "personality": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "description"
            ]
          }
        },
        "voice": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "do": {
              "$ref": "#/$defs/stringArray"
            },
            "dont": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "required": [
            "summary",
            "do",
            "dont"
          ]
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/brandMark"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/brandFont"
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "do": {
              "$ref": "#/$defs/stringArray"
            },
            "dont": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "required": [
            "do",
            "dont"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "name",
        "marks",
        "fonts"
      ]
    },
    "readinessItem": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "ready",
            "pending",
            "unresolved",
            "blocker"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "resolved",
            "declared",
            "declared-missing-artifact",
            "synthesized-missing"
          ]
        },
        "message": {
          "type": "string"
        },
        "artifactRef": {
          "type": "string"
        },
        "artifactExists": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "severity",
        "source",
        "message"
      ]
    },
    "readinessReport": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "prototypeSources": {
          "$ref": "#/$defs/stringArray"
        },
        "tier": {
          "type": "string",
          "enum": [
            "ready",
            "pending",
            "unresolved",
            "blocked"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readinessItem"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readinessItem"
          }
        }
      },
      "required": [
        "projectId",
        "prototypeSources",
        "tier",
        "items",
        "blockers"
      ]
    },
    "tokenUsage": {
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "boundaryId": {
          "type": "string"
        },
        "boundaryKind": {
          "type": "string",
          "enum": [
            "project",
            "board",
            "token-group",
            "primitive",
            "component",
            "screen",
            "section"
          ]
        },
        "styleRef": {
          "type": "string"
        }
      },
      "required": [
        "tokenId",
        "role",
        "boundaryId",
        "boundaryKind",
        "styleRef"
      ]
    },
    "deepHandoffPacket": {
      "type": "object",
      "properties": {
        "extraction": {
          "type": "object",
          "properties": {}
        },
        "boundaries": {
          "type": "array",
          "items": {}
        },
        "resolvedTokens": {
          "type": "array",
          "items": {}
        },
        "tokenUsage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tokenUsage"
          }
        }
      },
      "required": [
        "extraction",
        "boundaries",
        "resolvedTokens",
        "tokenUsage"
      ]
    },
    "inspoAspect": {
      "type": "string",
      "enum": [
        "mark",
        "wordmark",
        "typography",
        "color",
        "layout",
        "imagery",
        "style"
      ]
    },
    "inspoEntry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://\\S+$"
        },
        "image": {
          "type": "string",
          "pattern": "^inspo/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:png|jpg|webp|gif)$"
        },
        "aspects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspoAspect"
          },
          "uniqueItems": true
        },
        "stance": {
          "type": "string",
          "enum": [
            "like",
            "avoid"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "reading": {
          "type": "string",
          "maxLength": 240
        }
      },
      "required": [
        "id",
        "sourceUrl",
        "image",
        "aspects",
        "stance",
        "note",
        "reading"
      ],
      "additionalProperties": false
    },
    "inspoDirection": {
      "type": "object",
      "properties": {
        "aspect": {
          "$ref": "#/$defs/inspoAspect"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "entryIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved"
          ]
        }
      },
      "required": [
        "aspect",
        "statement",
        "entryIds",
        "status"
      ],
      "additionalProperties": false
    },
    "inspoFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "projectId": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspoEntry"
          }
        },
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspoDirection"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "entries",
        "directions"
      ],
      "additionalProperties": false,
      "description": "Optional reference board a new sidecar starts from. Cached images under inspo/ stay out of git."
    },
    "prototypeHost": {
      "type": "object",
      "properties": {
        "assetRoots": {
          "$ref": "#/$defs/stringArray"
        },
        "network": {
          "type": "string",
          "const": "deny"
        },
        "scripts": {
          "type": "string",
          "const": "none"
        }
      },
      "required": [
        "assetRoots",
        "network",
        "scripts"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "sourceRoot": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "owner",
        "sourceRoot"
      ]
    },
    "board": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "primitives",
            "screens"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ]
    },
    "framePreset": {
      "type": "object",
      "properties": {
